import pandas as pd
import matplotlib.pyplot as plt
data = {'Khóa': ['63', '64', '65', '66', '67', '68', '69', '70'],
        'Sinh viên': [39, 54, 56, 65, 67, 78, 90, 140 ]}
df = pd.DataFrame(data)
df.plot(x='Khóa', y='Sinh viên', kind='line',
        marker='o', title='Sinh viên ngành kĩ thuật Robot - UET')
plt.show()
